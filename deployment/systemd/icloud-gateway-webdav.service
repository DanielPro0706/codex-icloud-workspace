[Unit]
Description=Private iCloud Drive WebDAV gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=3
[Service]
User=icloud-gateway
Group=icloud-gateway
EnvironmentFile=/home/icloud-gateway/.config/icloud-gateway/webdav.env
ExecStart="/home/icloud-gateway/.local/bin/rclone-cn9399" "serve" "webdav" "Codex:" "--config" "/home/icloud-gateway/.config/rclone/rclone-cn.conf" "--addr" "127.0.0.1:18765" "--dir-cache-time" "30s" "--log-level" "ERROR" "--template" "/opt/icloud-gateway/ui/index.html" "--response-header" "Content-Security-Policy: default-src 'none'; script-src 'sha256-LYw34qCSzNdi55sEDE87FMh6ohhvOohQg6JScqyA3QE='; style-src 'sha256-AsfAsVOxBa2vwDXsp6fGPxuUK4W4mnD181eLO4Vw+CM='; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" "--response-header" "X-Content-Type-Options: nosniff" "--response-header" "Referrer-Policy: no-referrer" "--response-header" "Cache-Control: no-store"
Restart=on-failure
RestartSec=300
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/icloud-gateway/.config/rclone
CacheDirectory=icloud-gateway
Environment=XDG_CACHE_HOME=/var/cache/icloud-gateway
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
CPUQuota=50%
LogRateLimitIntervalSec=30s
LogRateLimitBurst=50
[Install]
WantedBy=multi-user.target
